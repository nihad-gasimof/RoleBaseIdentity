@model blet15.ViewModels.RegisterVM

@{
 ViewData["Title"] = "Qeydiyyat";
}

<div class="row justify-content-center mt-5">
 <div class="col-md-6 col-lg-5">
 <div class="card shadow-sm">
 <div class="card-body">
 <h3 class="card-title mb-4 text-center">İstifadəçi Qeydiyyatı</h3>

 <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

 <form asp-controller="Auth" asp-action="Register" method="post">
 @Html.AntiForgeryToken()

 <div class="mb-3">
 <label asp-for="UserName" class="form-label">İstifadəçi adı</label>
 <input asp-for="UserName" class="form-control" />
 <span asp-validation-for="UserName" class="text-danger"></span>
 </div>

 <div class="mb-3">
 <label asp-for="Email" class="form-label">Email</label>
 <input asp-for="Email" class="form-control" type="email" />
 <span asp-validation-for="Email" class="text-danger"></span>
 </div>

 <div class="mb-3">
 <label asp-for="Password" class="form-label">Şifrə</label>
 <input asp-for="Password" class="form-control" type="password" />
 <span asp-validation-for="Password" class="text-danger"></span>
 </div>

 <div class="mb-3">
 <label asp-for="ConfirmPassword" class="form-label">Şifrəni təsdiqlə</label>
 <input asp-for="ConfirmPassword" class="form-control" type="password" />
 <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
 </div>

 <div class="d-grid">
 <button type="submit" class="btn btn-success">Qeydiyyat</button>
 </div>
 </form>

 </div>
 </div>
 </div>
</div>

@section Scripts {
 <partial name="_ValidationScriptsPartial" />
}
